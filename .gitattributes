# Normalize line endings: LF in the repo and in working copies on all platforms.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (sprites, sounds, icons).
*.png binary
*.gif binary
*.ico binary
*.icns binary
*.wav binary
*.ogg binary
*.mp3 binary
